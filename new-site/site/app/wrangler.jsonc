{
  // Static site plus a Worker (worker.ts) that runs first: it redirects www, serves /media/* with byte
  // ranges (for seeking), and answers the MCP server at /mcp. Everything else is a static asset.
  "name": "dialect-engineering",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  // Keep the workers.dev address working alongside the custom domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "dialect-engineering.ai", "custom_domain": true },
    { "pattern": "www.dialect-engineering.ai", "custom_domain": true }
  ]
}
