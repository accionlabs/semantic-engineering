{
  // The prerendered pages as static assets, at the Worker's workers.dev address for review. The Worker
  // (worker.ts) runs only for /media/*, to serve the narration with byte ranges. The MCP server returns
  // later, and the semantic-engineering.ai routes are added at the switch.
  "name": "semantic-engineering",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash", "run_worker_first": ["/media/*"] },
  "workers_dev": true
}
