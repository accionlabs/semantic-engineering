{
  "name": "semantic-engineering-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "gsap": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "marked": "^18.0.14",
    "marked-smartypants": "^1.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^8.3.1",
    "yaml": "^2.9.1"
  }
}
