{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@film/*": ["../../video/animation/src/*"], "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"], "gsap": ["./node_modules/gsap"], "gsap/*": ["./node_modules/gsap/*"] }
  },
  "include": ["src"],
  "exclude": ["src/later"]
}
